# Copy to .env for local use. Never commit real credentials.
# On Dokploy, set these in the service's Environment tab instead.

# Web UI (KasmVNC) login
UID=1000
GID=1000
CUSTOM_USER=change-me
PASSWORD=change-me

# MetaTrader 5 account (optional)
# When MT5_LOGIN is set, the container generates a read-only MT5 config
# and starts the terminal already logged in.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Extra terminal64.exe command line options
MT5_CMD_OPTIONS=
